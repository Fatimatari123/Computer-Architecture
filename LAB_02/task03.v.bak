

module mux8to1_dataflow(
    input Y0, Y1, Y2, Y3, Y4, Y5, Y6, Y7,
    input S2, S1, S0,
    output X
);

assign X = (~S2 & ~S1 & ~S0 & Y0) |
           (~S2 & ~S1 &  S0 & Y1) |
           (~S2 &  S1 & ~S0 & Y2) |
           (~S2 &  S1 &  S0 & Y3) |
           ( S2 & ~S1 & ~S0 & Y4) |
           ( S2 & ~S1 &  S0 & Y5) |
           ( S2 &  S1 & ~S0 & Y6) |
           ( S2 &  S1 &  S0 & Y7);

endmodule


module tb_mux8to1_dataflow;

reg Y0, Y1, Y2, Y3, Y4, Y5, Y6, Y7;
reg S2, S1, S0;
wire X;

mux8to1_dataflow M1(
    .Y0(Y0),
    .Y1(Y1),
    .Y2(Y2),
    .Y3(Y3),
    .Y4(Y4),
    .Y5(Y5),
    .Y6(Y6),
    .Y7(Y7),
    .S2(S2),
    .S1(S1),
    .S0(S0),
    .X(X)
);

initial
begin
    
    Y0 = 1; Y1 = 0; Y2 = 1; Y3 = 1;
    Y4 = 0; Y5 = 1; Y6 = 0; Y7 = 0;

    S2=0; S1=0; S0=0; #10;
    S2=0; S1=0; S0=1; #10;
    S2=0; S1=1; S0=0; #10;
    S2=0; S1=1; S0=1; #10;
    S2=1; S1=0; S0=0; #10;
    S2=1; S1=0; S0=1; #10;
    S2=1; S1=1; S0=0; #10;
    S2=1; S1=1; S0=1; #10;

    
end

endmodule
