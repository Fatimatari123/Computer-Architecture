module task03(S2,S1,S0,A0,A1,A2,A3,A4,A5,A6,A7,y);
input S2,S1,S0,A0,A1,A2,A3,A4,A5,A6,A7;
output y;
wire s2not,s1not,s0not,a0,a1,a2,a3,a4,a5,a6,a7;
not n1(s2not,S2);
not n2(s1not,S1);
not n3(s0not,S0);
and aa0(a0,s2not,s1not,s0not,A0); //A0S2'S1'S0'
and aa1(a1,s2not,s1not,S0,A1);//A1S2'S1'S0
and aa2(a2,s2not,S1,s0not,A2);//A2S2'S1S0'
and aa3(a3,s2not,S1,S0,A3);//A3S2'S1S0
and aa4(a4,S2,s1not,s0not,A4);//A4S2S1'S0'
and aa5(a5,S2,s1not,S0,A5);//A5S2S1'S0
and aa6(a6,S2,S1,s0not,A6);//A6S2S1S0'
and aa7(a7,S2,S1,S0,A7);//A7S2S1S0
or o1(y,a0,a1,a2,a3,a4,a5,a6,a7);
endmodule

module testbench_multiplexer();
reg a0,a1,a2,a3,a4,a5,a6,a7,s0,s1,s2;
wire y;

task03 tts(s2,s1,s0,a0,a1,a2,a3,a4,a5,a6,a7,y);
initial 
begin
 a0=1; a1=1; a2=1; a3=1; a4=1; a5=1; a6=1; a7=1;
    s2=0; s1=0; s0=0;
    #50 s2=0; s1=0; s0=1;
    #50 s2=0; s1=1; s0=0;
    #50 s2=0; s1=1; s0=1;
    #50 s2=1; s1=0; s0=0;
    #50 s2=1; s1=0; s0=1;
    #50 s2=1; s1=1; s0=0;
    #50 s2=1; s1=1; s0=1;

    #50;
    a0=0; a1=0; a2=0; a3=0; a4=0; a5=0; a6=0; a7=0;
    s2=0; s1=0; s0=0;
    #50 s2=0; s1=0; s0=1;
    #50 s2=0; s1=1; s0=0;
    #50 s2=0; s1=1; s0=1;
    #50 s2=1; s1=0; s0=0;
    #50 s2=1; s1=0; s0=1;
    #50 s2=1; s1=1; s0=0;
    #50 s2=1; s1=1; s0=1;
    
end
endmodule

